---
// Prof. Young-Min Kim — full CV / bio. 본문(소개·Education·Experience·Honors·Contact)은
// src/content/pi/profile.json에서 읽어 Sveltia CMS('People · PI 프로필')로 항목 추가·삭제·편집한다.
// Selected publications는 publications-pi-selected 컬렉션이 Publications 전역 number만 참조 —
// 여기서 그 번호로 skku/before-skku 원본 논문을 찾아 렌더한다(논문 데이터 중복 저장 없음).
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatChemistry } from '@/utils/chemistry';
import PublicationsGraphic from '@components/PublicationsGraphic.astro';
import SectionGlyph from '@components/SectionGlyph.astro';
import ProbeField from '@components/ProbeField.astro';
import profileData from '@content/pi/profile.json';

type Publication = CollectionEntry<'publications-skku'>['data'];

interface CVEntry {
  years: string;
  title: string;
  institution: string;
}
// Experience는 start(YYYY-MM)를 정렬 키로 쓰고 years는 표시용 라벨이다.
interface ExperienceEntry extends CVEntry {
  start: string;
}
interface Honor {
  year: string;
  title: string;
  cert?: string;
  url?: string;
}
interface Profile {
  nameKo: string;
  nameEn: string;
  titles: string[];
  affiliations: string[];
  location: string;
  bio: string;
  education: CVEntry[];
  experience: ExperienceEntry[];
  honors: Honor[];
  contact: { email: string; phone?: string; orcid?: string; office?: string };
}

const profile = profileData as Profile;

// CMS 입력 순서와 무관하게 최신순 자동 정렬 — Experience는 start(YYYY-MM) 내림차순,
// Honors는 year 숫자 내림차순(같은 해는 안정 정렬로 입력 순서 유지).
const experience = [...profile.experience].sort((a, b) =>
  b.start.localeCompare(a.start)
);
const honors = [...profile.honors].sort(
  (a, b) => Number(b.year) - Number(a.year)
);

// Publications 전역 번호 → 원본 논문 조회 맵 (SKKU + Pre-SKKU SCI 통합, 번호는 전역 유일).
const pubByNumber = new Map<number, Publication>();
for (const e of await getCollection('publications-skku')) pubByNumber.set(e.data.number, e.data);
for (const e of await getCollection('publications-before-skku'))
  pubByNumber.set(e.data.number, e.data);

// pi-selected는 {category, number} 참조 목록 — 배열 순서(최신 입력이 위)대로 표시한다.
// 존재하지 않는 번호는 건너뛰며 빌드 경고를 남긴다.
const piSelected = (await getCollection('publications-pi-selected')).map((e) => e.data);
const resolve = (category: 'microscopy' | 'ai'): Publication[] =>
  piSelected
    .filter((s) => s.category === category)
    .map((s) => {
      const pub = pubByNumber.get(s.number);
      if (!pub)
        console.warn(
          `[pi.astro] Selected publication #${s.number} (${category}) not found in Publications.`
        );
      return pub;
    })
    .filter((pub): pub is Publication => pub !== undefined);

const microscopyMaterialsScience = resolve('microscopy');
const aiMicroscopy = resolve('ai');

const pubGroups: Array<{
  id: string;
  title: string;
  graphic: 'lattice' | 'denoise';
  entries: Publication[];
}> = [
  {
    id: 'pub-microscopy',
    title: 'Microscopy-based Materials Science',
    graphic: 'lattice',
    entries: microscopyMaterialsScience,
  },
  { id: 'pub-ai', title: 'AI Microscopy', graphic: 'denoise', entries: aiMicroscopy },
];
---

<BaseLayout
  title="Prof. Young-Min Kim · SKKU-STEM Lab"
  description="Curriculum vitae of Prof. Young-Min Kim, principal investigator of the SKKU-STEM Laboratory at Sungkyunkwan University."
>
  <div class="flex flex-col gap-12 md:gap-16 pb-24 md:pb-32">
    {/* ─────────────── Page header ─────────────── */}
    <section class="container-page pt-12 md:pt-20">
      <div class="container-prose relative" data-probe-host>
        <ProbeField />
        <div class="relative">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-coral-700">
          <a
            href="/people"
            class="text-ink/70 hover:text-coral underline underline-offset-2 transition-colors"
          >
            People
          </a>
          <span aria-hidden="true" class="mx-1.5 text-ink/55">/</span>
          Principal Investigator
        </p>

        <h1
          class="mt-6 font-display font-normal tracking-tight text-5xl md:text-6xl leading-[1.05]"
        >
          {profile.nameKo}
        </h1>
        <p
          class="mt-3 font-display text-2xl md:text-3xl text-ink/65 italic font-normal"
        >
          {profile.nameEn}
        </p>

        <p class="mt-7 text-base md:text-lg text-ink/80 leading-relaxed">
          {[...profile.titles, ...profile.affiliations, profile.location].map((line, i) => (
            <Fragment>{i > 0 && <br />}{line}</Fragment>
          ))}
        </p>

        <p
          tabindex="0"
          class="lift-row mt-8 px-4 py-4 -mx-4 font-serif text-base md:text-lg text-ink/90 leading-relaxed text-justify hyphens-auto"
        >
          {profile.bio}
        </p>
        </div>
      </div>
    </section>

    {/* ─────────────── Education ─────────────── */}
    <section
      id="education"
      class="container-page scroll-mt-12 md:scroll-mt-20"
    >
      <div class="container-prose">
        <div
          class="flex items-end justify-between gap-3 pb-3 border-b border-ink/15"
        >
          <h2
            class="font-mono text-sm md:text-base font-bold uppercase tracking-[0.16em] text-coral-500"
          >
            Education
          </h2>
          <SectionGlyph variant="beam" />
        </div>
        <ul class="mt-3 divide-y divide-ink/10">
          {
            profile.education.map((item) => (
              <li class="lift-row group py-2.5 px-4 -mx-4 grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-0.5 md:gap-5 items-baseline">
                <time class="font-mono text-xs text-ink/65 group-hover:text-coral-700 tabular-nums whitespace-nowrap transition-colors">
                  {item.years}
                </time>
                <div>
                  <p class="text-sm md:text-base leading-snug">{item.title}</p>
                  <p class="mt-0.5 text-[13px] text-ink/60 leading-snug">{item.institution}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ─────────────── Research Experience ─────────────── */}
    <section
      id="experience"
      class="container-page scroll-mt-12 md:scroll-mt-20"
    >
      <div class="container-prose">
        <div
          class="flex items-end justify-between gap-3 pb-3 border-b border-ink/15"
        >
          <h2
            class="font-mono text-sm md:text-base font-bold uppercase tracking-[0.16em] text-coral-500"
          >
            Research Experience
          </h2>
          <SectionGlyph variant="trajectory" />
        </div>
        <ul class="mt-3 divide-y divide-ink/10">
          {
            experience.map((item) => (
              <li class="lift-row group py-2.5 px-4 -mx-4 grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-0.5 md:gap-5 items-baseline">
                <time class="font-mono text-xs text-ink/65 group-hover:text-coral-700 tabular-nums whitespace-nowrap transition-colors">
                  {item.years}
                </time>
                <div>
                  <p class="text-sm md:text-base leading-snug">{item.title}</p>
                  <p class="mt-0.5 text-[13px] text-ink/60 leading-snug">{item.institution}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ─────────────── Honors ─────────────── */}
    <section
      id="honors"
      class="container-page scroll-mt-12 md:scroll-mt-20"
    >
      <div class="container-prose">
        <div
          class="flex items-end justify-between gap-3 pb-3 border-b border-ink/15"
        >
          <h2
            class="font-mono text-sm md:text-base font-bold uppercase tracking-[0.16em] text-coral-500"
          >
            Honors &amp; Awards
          </h2>
          <SectionGlyph variant="lattice" />
        </div>
        <ul class="mt-3 divide-y divide-ink/10">
          {
            honors.map((item) => (
              <li class="lift-row group py-2.5 px-4 -mx-4 grid grid-cols-1 md:grid-cols-[12rem_1fr] gap-0.5 md:gap-5 items-baseline">
                <time class="font-mono text-xs text-ink/65 group-hover:text-coral-700 tabular-nums whitespace-nowrap transition-colors">
                  {item.year}
                </time>
                <p class="text-sm md:text-base leading-snug">
                  {item.url ? (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline decoration-ink/20 underline-offset-4 hover:text-coral hover:decoration-coral transition-colors"
                    >
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                  {item.cert && (
                    <span class="ml-2 font-mono text-[11px] text-ink/60 whitespace-nowrap">
                      No. {item.cert}
                    </span>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ─────────────── Selected Publications ─────────────── */}
    <section
      id="publications"
      class="container-page scroll-mt-12 md:scroll-mt-20"
    >
      <div class="container-prose">
        <h2
          class="font-mono text-sm md:text-base font-bold uppercase tracking-[0.16em] text-coral-500 pb-3 border-b border-ink/15"
        >
          Selected Publications
        </h2>

        {
          pubGroups.map((group) => (
            <div
              id={group.id}
              data-pub-group
              class="mt-8 first:mt-6 scroll-mt-12 md:scroll-mt-20"
            >
              <div class="flex items-center justify-between gap-4">
                <h3 class="font-display text-xl md:text-2xl font-normal tracking-tight">
                  {group.title}
                </h3>
                <PublicationsGraphic variant={group.graphic} />
              </div>

              <ol class="mt-4 divide-y divide-ink/10">
                {group.entries.map((pub) => (
                  <li class="lift-row group py-3 px-4 -mx-4 grid grid-cols-1 md:grid-cols-[4rem_1fr] gap-1 md:gap-5 items-baseline">
                    <time
                      class="font-mono text-xs text-ink/65 group-hover:text-coral-700 tabular-nums whitespace-nowrap transition-colors"
                      datetime={String(pub.year)}
                    >
                      {pub.year}
                    </time>
                    <div>
                      <p class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-coral-400">
                        {pub.journal}
                        {pub.volumePages && (
                          <span class="text-ink/65 font-normal normal-case ml-1.5">
                            &middot; {pub.volumePages}
                          </span>
                        )}
                      </p>
                      <p class="mt-1 text-sm md:text-base leading-snug font-serif text-ink">
                        {pub.doi ? (
                          <a
                            href={pub.doi}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="no-underline hover:text-coral transition-colors"
                            set:html={formatChemistry(pub.title)}
                          />
                        ) : (
                          <Fragment set:html={formatChemistry(pub.title)} />
                        )}
                      </p>
                      <p class="mt-1 text-[11px] text-ink/60 leading-snug">
                        {pub.authors}
                      </p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }

        <p class="mt-10 pt-6 border-t border-ink/15 text-xs text-ink/70 italic leading-relaxed">
          &dagger; equal contribution &middot; * indicates corresponding author(s)
        </p>
      </div>
    </section>

    {/* ─────────────── Contact ─────────────── */}
    <section id="contact" class="container-page scroll-mt-12 md:scroll-mt-20">
      <div class="container-prose">
        <div
          class="flex items-end justify-between gap-3 pb-3 border-b border-ink/15"
        >
          <h2
            class="font-mono text-sm md:text-base font-bold uppercase tracking-[0.16em] text-coral-500"
          >
            Contact
          </h2>
          <SectionGlyph variant="diffraction" />
        </div>
        <dl
          class="mt-4 grid grid-cols-1 md:grid-cols-[8rem_1fr] gap-y-3 md:gap-y-2 text-sm md:text-base"
        >
          <dt class="text-sm font-mono uppercase tracking-[0.14em] text-ink/70">
            Email
          </dt>
          <dd>
            <a
              href={`mailto:${profile.contact.email}`}
              class="hover:text-coral transition-colors"
            >
              {profile.contact.email}
            </a>
          </dd>

          {
            profile.contact.phone && (
              <>
                <dt class="text-sm font-mono uppercase tracking-[0.14em] text-ink/70">
                  Phone
                </dt>
                <dd>
                  <a
                    href={`tel:${profile.contact.phone.replace(/[^+\d]/g, '')}`}
                    class="hover:text-coral transition-colors"
                  >
                    {profile.contact.phone}
                  </a>
                </dd>
              </>
            )
          }

          {
            profile.contact.orcid && (
              <>
                <dt class="text-sm font-mono uppercase tracking-[0.14em] text-ink/70">
                  ORCID
                </dt>
                <dd>
                  <a
                    href={`https://orcid.org/${profile.contact.orcid}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-coral transition-colors font-mono text-sm"
                  >
                    {profile.contact.orcid}
                  </a>
                </dd>
              </>
            )
          }

          {
            profile.contact.office && (
              <>
                <dt class="text-sm font-mono uppercase tracking-[0.14em] text-ink/70">
                  Office
                </dt>
                <dd class="text-ink/85 leading-relaxed whitespace-pre-line">
                  {profile.contact.office}
                </dd>
              </>
            )
          }
        </dl>
      </div>
    </section>
  </div>
</BaseLayout>
