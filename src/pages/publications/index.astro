---
// Publications — SKKU 시기 SCI 논문 (메인 페이지)
// 데이터: src/content/publications/skku.json (Astro Content Collection)
// 하위 페이지: /publications/before-skku, /publications/non-sci-patents
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatChemistry } from '@/utils/chemistry';

type Publication = CollectionEntry<'publications-skku'>['data'];

const skkuPublications = (await getCollection('publications-skku'))
  .map((e) => e.data)
  .sort((a, b) => b.number - a.number);

// before-SKKU 컬렉션은 본 페이지에 리스트로 표시하지 않고 전체 경력 통계용으로만 합산
const preSkkuPublications = (await getCollection('publications-before-skku'))
  .map((e) => e.data);

// 연도별 그룹핑 (SKKU 기간만 본 페이지에 표시)
const byYear = skkuPublications.reduce<Record<number, Publication[]>>(
  (acc, p) => {
    (acc[p.year] ??= []).push(p);
    return acc;
  },
  {}
);

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);

const total = skkuPublications.length;
const leadCount = skkuPublications.filter((p) => p.lead).length;
const coCount = total - leadCount;
const minYear = Math.min(...years);
const maxYear = Math.max(...years);

// 전체 경력 (pre-SKKU + SKKU) — 컬렉션 길이/연도/lead 필드로 build-time 자동 산출
const grandTotal = skkuPublications.length + preSkkuPublications.length;
const grandLeadCount = leadCount + preSkkuPublications.filter((p) => p.lead).length;
const grandCoCount = grandTotal - grandLeadCount;
const grandMinYear = Math.min(
  ...years,
  ...preSkkuPublications.map((p) => p.year),
);

// 헤더 배경 — 출판물이 빠르게 쌓이는 더미. 아래(오래된)→위(최신) 순으로 차곡차곡 떨어져 쌓이며
// 성장. 위로 갈수록 또렷해지고 최신 3장은 코랄 강조, 맨 위(최신) 1장은 경쾌하게 떠오름.
const SHEET_N = 11;
const STACK = [...Array(SHEET_N)].map((_, i) => {
  const jitterX = [-5, 4, -3, 5, -4, 3, -5, 2, -3, 1, 0][i];
  const rot = [-1.6, 1.2, -1, 1.4, -1.1, 0.9, -1.3, 0.7, -0.8, 0.4, 0][i];
  const isCoral = i >= SHEET_N - 3; // 최신 3장 코랄
  const isTop = i === SHEET_N - 1; // 맨 위(최신)
  // 위로 갈수록 또렷 (오래된 아래는 옅게)
  const depth = i / (SHEET_N - 1);
  const coralStep = i - (SHEET_N - 3); // 코랄 3장: 0,1,2
  return {
    x: 636 + jitterX,
    y: 240 - i * 17, // 바닥에서 위로 쌓임
    rot,
    isCoral,
    isTop,
    stroke: isCoral ? '#CC785C' : '#141413',
    strokeOpacity: isCoral ? 0.58 + coralStep * 0.07 : 0.26 + depth * 0.16,
    fill: isCoral ? '#CC785C' : '#FBFAF4',
    fillOpacity: isCoral ? 0.13 + coralStep * 0.04 : 0.78,
    delay: i * 0.12, // 아래부터 순차 등장
  };
});
---

<BaseLayout
  title="Publications · SKKU-STEM Lab"
  description="Peer-reviewed publications from the SKKU-STEM Laboratory at Sungkyunkwan University."
>
  <div class="section-stack pb-24 md:pb-32">
    {/* ─────────────── Page header ─────────────── */}
    <section class="container-page pt-12 md:pt-20 relative">
      {/* 배경 그래픽 — 출판물이 빠르게 쌓이는 더미. 아래(오래된)→위(최신) 순으로 차곡차곡 떨어져
          쌓이며 성장. 최신 3장은 코랄 강조, 맨 위 1장은 경쾌하게 떠오름. 우측 정렬로 좌측 텍스트 보호. */}
      <svg
        viewBox="0 0 800 280"
        preserveAspectRatio="xMaxYMid slice"
        class="absolute inset-0 w-full h-full pointer-events-none"
        aria-hidden="true"
      >
        {
          STACK.map((s) => (
            <g transform={`translate(${s.x} ${s.y}) rotate(${s.rot})`}>
              <g
                class={s.isTop ? 'sheet sheet--top' : 'sheet'}
                style={`--d:${s.delay}s`}
              >
                {/* 한 장의 논문 — 옆에서 본 얇은 시트 (테두리 + 제목 tick + 본문 line) */}
                <rect
                  x="-86"
                  y="-9"
                  width="172"
                  height="18"
                  rx="2.5"
                  fill={s.fill}
                  fill-opacity={s.fillOpacity}
                  stroke={s.stroke}
                  stroke-width="1"
                  stroke-opacity={s.strokeOpacity}
                />
                <rect
                  x="-77"
                  y="-4.5"
                  width="30"
                  height="3"
                  rx="1"
                  fill={s.stroke}
                  opacity={s.isCoral ? 0.6 : 0.36}
                />
                <line
                  x1="-41"
                  y1="-3"
                  x2="72"
                  y2="-3"
                  stroke={s.stroke}
                  stroke-width="0.7"
                  opacity={s.isCoral ? 0.45 : 0.26}
                />
                <line
                  x1="-41"
                  y1="3.2"
                  x2="54"
                  y2="3.2"
                  stroke={s.stroke}
                  stroke-width="0.7"
                  opacity={s.isCoral ? 0.36 : 0.2}
                />
              </g>
            </g>
          ))
        }
      </svg>

      <div class="relative max-w-3xl">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-coral-700">
          Publications
        </p>
        <h1
          class="mt-6 font-display font-normal tracking-tight text-5xl md:text-6xl leading-[1.05]"
        >
          The Record
        </h1>
        <p class="mt-7 text-base md:text-lg text-ink/75 leading-relaxed">
          <span class="font-mono tabular-nums text-ink">{grandTotal}</span> SCI
          papers across the full career ({grandMinYear}&ndash;{maxYear})
          <br />
          &mdash;{' '}
          <span class="text-coral-400 font-medium tabular-nums">{grandLeadCount}</span>{' '}
          lead authorship &amp;{' '}
          <span class="text-ink/85 tabular-nums">{grandCoCount}</span>{' '}
          co-authorship
        </p>
        <p class="mt-3 text-base md:text-lg text-ink/75 leading-relaxed">
          <span class="font-mono tabular-nums text-ink">{total}</span> SCI papers
          since {minYear} at SKKU
          &mdash;{' '}
          <span class="text-coral-400 font-medium tabular-nums">{leadCount}</span>{' '}
          lead authorship &amp;{' '}
          <span class="text-ink/85 tabular-nums">{coCount}</span>{' '}
          co-authorship
        </p>
      </div>
    </section>

    {/* ─────────────── Sub-page nav ─────────────── */}
    <section class="container-page">
      <nav
        aria-label="Publications sections"
        class="flex flex-wrap items-baseline gap-x-3 gap-y-3 pb-8 border-b border-ink/20"
      >
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink/70 mr-2">
          Sections
        </span>
        <span
          class="inline-flex items-center px-4 py-2 border border-coral text-coral bg-coral/10 rounded-md text-sm font-medium"
          aria-current="page"
        >
          SCI ({minYear}&ndash;{maxYear})
        </span>
        <a
          href="/publications/before-skku"
          class="inline-flex items-center px-4 py-2 bg-ink text-cream rounded-md text-sm font-medium hover:bg-ink-700 transition-colors"
        >
          Before SKKU (2000&ndash;2015)
        </a>
        <a
          href="/publications/non-sci-patents"
          class="inline-flex items-center px-4 py-2 bg-ink text-cream rounded-md text-sm font-medium hover:bg-ink-700 transition-colors"
        >
          Non-SCI &amp; Patents
        </a>
      </nav>
    </section>

    {/* ─────────────── Year jump nav ─────────────── */}
    <section class="container-page">
      <nav
        aria-label="Jump to year"
        class="flex flex-wrap items-baseline gap-x-3 gap-y-2 pb-6 border-b border-ink/15"
      >
        <span
          class="font-mono text-[11px] uppercase tracking-[0.16em] text-ink/70 mr-2"
        >
          Jump
        </span>
        {
          years.map((year) => (
            <a
              href={`#year-${year}`}
              class="font-mono text-sm tabular-nums text-ink/70 hover:text-coral transition-colors"
            >
              {year}
            </a>
          ))
        }
      </nav>
    </section>

    {/* ─────────────── Year-grouped list ─────────────── */}
    <section class="container-page">
      <div class="space-y-10">
        {
          years.map((year) => (
            <div class="grid md:grid-cols-[5rem_1fr] gap-x-6 lg:gap-x-10">
              <h2
                id={`year-${year}`}
                class="md:sticky md:top-20 self-start scroll-mt-20 font-display font-normal text-3xl md:text-4xl tracking-tight tabular-nums text-coral"
              >
                {year}
              </h2>

              <ol>
                {byYear[year].map((p) => (
                  <li
                    class:list={[
                      'pub-row grid grid-cols-[2.5rem_1fr] gap-x-4',
                      p.lead ? 'lift-row py-3 px-3 -mx-3' : 'py-3',
                    ]}
                  >
                    <span
                      class:list={[
                        'font-mono text-sm tabular-nums text-right pt-0.5',
                        p.lead ? 'text-coral-400 font-medium' : 'text-ink/65',
                      ]}
                    >
                      {p.number}
                    </span>
                    <div>
                      <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-coral-400 font-bold">
                        {p.journal}
                        {p.volumePages && (
                          <span class="text-ink/65 normal-case font-normal ml-1.5">
                            &middot; {p.volumePages}
                          </span>
                        )}
                      </p>
                      <p class="mt-1.5 text-sm md:text-base leading-snug font-serif text-ink/95">
                        {p.doi ? (
                          <a
                            href={p.doi}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-coral transition-colors"
                            set:html={formatChemistry(p.title)}
                          />
                        ) : (
                          <Fragment set:html={formatChemistry(p.title)} />
                        )}
                      </p>
                      <p class="mt-1.5 text-xs text-ink/60 leading-relaxed">
                        {p.authors}
                      </p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* 헤더 배경 — 논문이 아래부터 차곡차곡 떨어져 쌓이는 더미. 빌드(빠른 쌓임)→유지→해제 루프.
     stagger는 animation-delay(같은 duration → 위상만 고정 어긋남)로 표현해 매 사이클 순차 등장. */
  .sheet {
    transform-box: fill-box;
    transform-origin: center;
    animation: sheet-stack 8s ease-in-out infinite backwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes sheet-stack {
    0% { opacity: 0; transform: translateY(-26px) scale(0.96); }
    7% { opacity: 1; transform: translateY(0) scale(1); }
    86% { opacity: 1; transform: translateY(0) scale(1); }
    100% { opacity: 0; transform: translateY(-12px) scale(0.98); }
  }

  /* 맨 위(최신) 논문 — 경쾌하게 튀어 올라 안착한 뒤 살짝 들썩 */
  .sheet--top {
    animation: sheet-stack-top 8s ease-out infinite backwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes sheet-stack-top {
    0% { opacity: 0; transform: translateY(-44px); }
    6% { opacity: 1; transform: translateY(-9px); }
    10% { transform: translateY(0); }
    14% { transform: translateY(-5px); }
    18% { transform: translateY(0); }
    45% { transform: translateY(-3px); }
    66% { transform: translateY(0); }
    86% { opacity: 1; transform: translateY(-2px); }
    100% { opacity: 0; transform: translateY(-18px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet, .sheet--top {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
