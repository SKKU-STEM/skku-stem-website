---
// 푸터 좌측 디지털 odometer 방문자 카운터 — /api/visits(Cloudflare KV) 사용, 세션당 1회만 increment
---

<div class="visitor-counter" aria-label="Site visitor count">
  <span class="visitor-counter__label">Visitors</span>
  <div
    class="visitor-counter__digits"
    data-visitor-digits
    aria-live="polite"
    aria-atomic="true"
  >
    <span class="visitor-counter__digit visitor-counter__digit--idle">–</span>
    <span class="visitor-counter__digit visitor-counter__digit--idle">–</span>
    <span class="visitor-counter__digit visitor-counter__digit--idle">–</span>
    <span class="visitor-counter__digit visitor-counter__digit--idle">–</span>
    <span class="visitor-counter__digit visitor-counter__digit--idle">–</span>
  </div>
</div>

<style>
  .visitor-counter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.625rem;
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--color-cream) 4%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-cream) 10%, transparent);
  }

  .visitor-counter__label {
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-cream) 55%, transparent);
    font-weight: 500;
  }

  .visitor-counter__digits {
    display: inline-flex;
    gap: 0.125rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .visitor-counter__digit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.0625rem;
    height: 1.375rem;
    padding: 0 0.1875rem;
    border-radius: 0.25rem;
    background-color: #0a0a09;
    border: 1px solid color-mix(in oklab, var(--color-cream) 8%, transparent);
    color: var(--color-coral-400);
    font-weight: 700;
    font-size: 0.8125rem;
    line-height: 1;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      inset 0 -1px 0 rgba(0, 0, 0, 0.45);
    transition: color 0.25s ease;
  }

  .visitor-counter__digit--idle {
    color: color-mix(in oklab, var(--color-cream) 22%, transparent);
  }
</style>

<script>
  const ENDPOINT = '/api/visits';
  const SESSION_KEY = 'skku-stem-visitor-counted';
  const CACHE_KEY = 'skku-stem-visitor-count';
  const MIN_DIGITS = 5;

  function renderDigits(n: number) {
    const root = document.querySelector('[data-visitor-digits]');
    if (!root) return;
    const padded = String(Math.max(0, Math.floor(n))).padStart(MIN_DIGITS, '0');
    root.innerHTML = '';
    for (const ch of padded) {
      const cell = document.createElement('span');
      cell.className = 'visitor-counter__digit';
      cell.textContent = ch;
      root.appendChild(cell);
    }
  }

  function readCache(): number | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      if (raw === null) return null;
      const n = Number(raw);
      return Number.isFinite(n) ? n : null;
    } catch {
      return null;
    }
  }

  function writeCache(n: number) {
    try {
      localStorage.setItem(CACHE_KEY, String(n));
    } catch {
      /* private 모드 등에서 setItem 실패 시 무시 */
    }
  }

  async function loadCount() {
    // 페이지 이동 후 재방문 시에도 마지막 집계값을 즉시 표시
    const cached = readCache();
    if (cached !== null) renderDigits(cached);

    // 세션당 1회만 increment — 그 외 페이지 이동에서는 조회만 해서 최신값을 보여준다
    let counted = true;
    try {
      counted = sessionStorage.getItem(SESSION_KEY) !== null;
    } catch {
      /* private 모드 등에서 sessionStorage 접근 실패 시 조회만 */
    }

    try {
      const res = await fetch(ENDPOINT, {
        method: counted ? 'GET' : 'POST',
        cache: 'no-store',
      });
      if (!res.ok) {
        // 조용히 실패하면 캐시값이 그대로 굳어 "멈춘 카운터"가 된다. 반드시 남긴다.
        console.warn(`[visitor-counter] ${ENDPOINT} responded ${res.status}`);
        return;
      }
      const json = (await res.json()) as { count?: number };
      if (typeof json?.count !== 'number') {
        console.warn('[visitor-counter] unexpected response payload', json);
        return;
      }
      if (!counted) {
        try {
          sessionStorage.setItem(SESSION_KEY, '1');
        } catch {
          /* private 모드 등에서 setItem 실패 시 무시 */
        }
      }
      writeCache(json.count);
      renderDigits(json.count);
    } catch (err) {
      console.warn('[visitor-counter] request failed', err);
    }
  }

  loadCount();
</script>
