---
// 노스 모달 문단 2용 연구 지도 — 합성 대신 STEM·전자분광·머신러닝으로 4개 소재 분야의 원자 단위 원인을 규명한다는 흐름
const TOOLS = [
  { name: '수차보정 STEM', sub: 'Cs-corrected STEM' },
  { name: '전자분광', sub: 'EELS · EDX' },
  { name: '머신러닝', sub: 'Deep learning' },
];
const FIELDS = [
  { name: 'AI 반도체 소재', sub: 'HfO₂ 강유전체 · 2D 반도체' },
  { name: '수소 연료전지', sub: 'PEMFC · SOFC 전극' },
  { name: '촉매', sub: 'Pt 나노입자 · 산화물' },
  { name: '태양전지', sub: '페로브스카이트' },
];
---

<figure class="rm-fig" lang="ko">
  <h3 class="rm-title">합성 대신, 원자를 보고 설명합니다</h3>
  <p class="sr-only">
    연구실은 소재를 합성하거나 제조하지 않습니다. 수차보정 주사투과전자현미경(STEM), 전자분광(EELS·EDX),
    머신러닝으로 AI 반도체 소재(HfO₂ 강유전체, 2D 반도체), 수소 연료전지, 촉매, 태양전지 소재의 물성이
    왜 그렇게 나타나는지를 원자 단위에서 규명합니다.
  </p>

  <div class="rm-flow" aria-hidden="true">
    <ul class="rm-col rm-tools">
      {TOOLS.map((t) => (
        <li class="rm-chip">
          <span class="rm-chip-name">{t.name}</span>
          <span class="rm-chip-sub">{t.sub}</span>
        </li>
      ))}
    </ul>

    <svg class="rm-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h15M14 6l6 6-6 6" />
    </svg>

    <div class="rm-core">
      <svg class="rm-lattice" viewBox="0 0 120 104">
        <g fill="currentColor" opacity="0.35">
          {[0, 1, 2, 3].map((r) =>
            [0, 1, 2, 3, 4].map((c) => (
              <circle cx={14 + c * 23 + (r % 2) * 11.5} cy={16 + r * 24} r="4.2" />
            )),
          )}
        </g>
        {/* 원인으로 지목된 원자 하나 — 코랄 강조 + 검출 링 */}
        <circle cx="71.5" cy="40" r="5.5" class="rm-hot" />
        <circle cx="71.5" cy="40" r="11" fill="none" class="rm-ring" stroke-width="1.4" />
      </svg>
      <p class="rm-core-name">원자 단위 원인 규명</p>
      <p class="rm-core-sub">구조 · 화학 · 결함</p>
    </div>

    <svg class="rm-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h15M14 6l6 6-6 6" />
    </svg>

    <ul class="rm-col rm-fields">
      {FIELDS.map((f) => (
        <li class="rm-chip rm-chip--field">
          <span class="rm-chip-name">{f.name}</span>
          <span class="rm-chip-sub">{f.sub}</span>
        </li>
      ))}
    </ul>
  </div>
</figure>

<style>
  .rm-fig {
    word-break: keep-all;
    container-type: inline-size;
    border: 1px solid var(--color-cream-300);
    border-radius: var(--radius-lg);
    background: var(--color-cream-50);
    padding: 1rem 1rem 0.85rem;
  }
  .rm-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .rm-flow {
    margin-top: 0.85rem;
    display: grid;
    grid-template-columns: 1fr auto 1.05fr auto 1.15fr;
    align-items: center;
    gap: 0.5rem;
  }
  .rm-col {
    display: grid;
    gap: 0.4rem;
  }
  .rm-chip {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    border: 1px solid var(--color-cream-400);
    border-radius: var(--radius-md);
    background: var(--color-cream);
    padding: 0.4rem 0.55rem;
  }
  .rm-chip--field {
    border-color: color-mix(in oklab, var(--color-coral) 55%, var(--color-cream-300));
    background: color-mix(in oklab, var(--color-coral) 7%, var(--color-cream));
  }
  .rm-chip-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .rm-chip-sub {
    font-size: 0.6875rem;
    color: color-mix(in oklab, var(--color-ink) 72%, transparent);
    line-height: 1.3;
  }
  .rm-arrow {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-coral-600);
  }
  .rm-core {
    text-align: center;
    color: var(--color-ink);
  }
  .rm-lattice {
    width: 100%;
    max-width: 8.5rem;
    margin: 0 auto;
    display: block;
  }
  .rm-hot {
    fill: var(--color-coral);
  }
  .rm-ring {
    stroke: var(--color-coral-600);
  }
  .rm-core-name {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-coral-700);
  }
  .rm-core-sub {
    font-size: 0.6875rem;
    color: color-mix(in oklab, var(--color-ink) 72%, transparent);
  }
  /* 좁은 폭(모달 열 기준 컨테이너 쿼리): 위→아래 흐름, 도구는 한 줄 3칸, 분야는 2×2 */
  @container (max-width: 34rem) {
    .rm-flow {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }
    .rm-tools {
      grid-template-columns: repeat(3, 1fr);
    }
    .rm-fields {
      grid-template-columns: repeat(2, 1fr);
    }
    .rm-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
    .rm-lattice {
      max-width: 6.5rem;
    }
  }
</style>
