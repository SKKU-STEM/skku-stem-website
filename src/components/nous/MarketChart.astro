---
// 노스 모달 문단 3용 글로벌 AI 반도체 시장 규모 막대 — KISDI Perspectives 2024 No.1 그림 4(원자료 Gartner 2024.4) 값
const SOURCE_URL = 'https://www.kisdi.re.kr/bbs/view.do?bbsSn=114496&key=m2101113055776';

// 백만 달러(원문) → 화면은 억 달러 반올림
const DATA = [
  { year: 2023, musd: 53662 },
  { year: 2024, musd: 71252 },
  { year: 2025, musd: 91955 },
  { year: 2026, musd: 116269 },
  { year: 2027, musd: 141397 },
  { year: 2028, musd: 159022 },
].map((d) => ({ ...d, eok: Math.round(d.musd / 100), actual: d.year === 2023 }));

const max = Math.max(...DATA.map((d) => d.eok));
const fmt = (n: number) => n.toLocaleString('ko-KR');
// 값 라벨 위를 지나는 성장 곡선(0–100 좌표, 막대 영역 기준, 라벨 높이만큼 22 띄움)
const curve = DATA.map((d, i) => `${((i + 0.5) / DATA.length) * 100},${100 - (d.eok / max) * 100 - 22}`).join(' ');
---

<figure class="mc-fig" lang="ko">
  <h3 class="mc-title">글로벌 AI 반도체 시장 규모</h3>
  <p class="mc-sub">2023→2028년 연평균 <strong>24.3%</strong> 성장 전망 <span class="mc-unit">(매출액 기준 · 단위 억 달러)</span></p>
  <p class="sr-only">
    글로벌 AI 반도체 시장 규모는 2023년 {fmt(DATA[0].eok)}억 달러(실적)에서 2024년 {fmt(DATA[1].eok)}억, 2025년
    {fmt(DATA[2].eok)}억, 2026년 {fmt(DATA[3].eok)}억, 2027년 {fmt(DATA[4].eok)}억, 2028년 {fmt(DATA[5].eok)}억 달러로
    연평균 24.3% 성장할 것으로 전망됩니다. 2024년 이후 값은 2024년 4월 시점의 전망치입니다.
  </p>

  <div class="mc-plot" aria-hidden="true">
    <div class="mc-bars">
      {DATA.map((d) => (
        <div class="mc-col">
          <span class="mc-val">{fmt(d.eok)}</span>
          <span class:list={['mc-bar', d.actual ? 'mc-bar--actual' : 'mc-bar--proj']} style={`height:${(d.eok / max) * 100}%`} />
        </div>
      ))}
      <svg class="mc-curve" viewBox="0 0 100 100" preserveAspectRatio="none">
        <polyline points={curve} fill="none" vector-effect="non-scaling-stroke" />
      </svg>
      <span class="mc-badge">연평균 +24.3%</span>
    </div>
    <div class="mc-axis">
      {DATA.map((d) => <span>{d.year}</span>)}
    </div>
    <div class="mc-legend">
      <span class="mc-key"><i class="mc-bar--actual" />실적</span>
      <span class="mc-key"><i class="mc-bar--proj" />전망(2024년 4월 시점)</span>
    </div>
  </div>

  <figcaption class="mc-cap">
    출처: KISDI Perspectives 2024 No.1(원자료 Gartner, 2024.4) ·
    <a href={SOURCE_URL} target="_blank" rel="noopener noreferrer">원문</a>
  </figcaption>
</figure>

