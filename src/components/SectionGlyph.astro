---
// PI CV 섹션 제목(mono 라벨) 옆 동적 글리프 — 각 섹션을 은유적으로 심상화하는 작은 SVG 애니메이션.
// beam=Education(내려오는 전자빔이 학위 노드를 훑음) · trajectory=Experience(기관을 오가는 경력 궤적) ·
// lattice=Honors(수상 격자 순차 점등) · diffraction=Contact(4D-STEM 회절 패턴 맥동).
// 순수 SVG + CSS 애니메이션, 색은 Tailwind fill/stroke 유틸. prefers-reduced-motion 시 정지.
interface Props {
  variant: 'beam' | 'trajectory' | 'lattice' | 'diffraction';
}
const { variant } = Astro.props;

// 회절: 중심 + 두 동심 육각 링 좌표(viewBox 36 기준, 중심 18,18)
const ring1 = [...Array(6)].map((_, k) => {
  const a = (Math.PI / 3) * k;
  return { x: 18 + 8 * Math.cos(a), y: 18 + 8 * Math.sin(a) };
});
const ring2 = [...Array(6)].map((_, k) => {
  const a = (Math.PI / 3) * k + Math.PI / 6;
  return { x: 18 + 14 * Math.cos(a), y: 18 + 14 * Math.sin(a) };
});

// 수상 격자: 3×3 사이트 + 대각선 점등 지연
const lattice = [9, 18, 27].flatMap((y, r) =>
  [9, 18, 27].map((x, c) => ({ x, y, d: (r + c) * 0.18 }))
);
---

{
  variant === 'beam' && (
    <svg viewBox="0 0 36 36" class="glyph" aria-hidden="true">
      <line
        x1="18"
        y1="7"
        x2="18"
        y2="29"
        class="stroke-ink"
        stroke-width="1.3"
        opacity="0.22"
        stroke-linecap="round"
      />
      <circle cx="18" cy="9" r="2.2" class="g-node fill-coral" style="--d:0s" />
      <circle cx="18" cy="18" r="2.2" class="g-node fill-coral" style="--d:0.25s" />
      <circle cx="18" cy="27" r="2.2" class="g-node fill-coral" style="--d:0.5s" />
      <circle cx="18" cy="9" r="2.7" class="g-beam fill-coral" />
    </svg>
  )
}

{
  variant === 'trajectory' && (
    <svg viewBox="0 0 36 36" class="glyph" aria-hidden="true">
      <path
        d="M6 28 C9 9 27 9 30 28"
        fill="none"
        class="stroke-ink"
        stroke-width="1.3"
        opacity="0.22"
        stroke-linecap="round"
      />
      <circle cx="6" cy="28" r="2.1" class="fill-coral" opacity="0.45" />
      <circle cx="18" cy="12" r="2.1" class="fill-coral" opacity="0.45" />
      <circle cx="30" cy="28" r="2.1" class="fill-coral" opacity="0.45" />
      <circle cx="6" cy="28" r="2.7" class="g-traj fill-coral" />
    </svg>
  )
}

{
  variant === 'lattice' && (
    <svg viewBox="0 0 36 36" class="glyph" aria-hidden="true">
      {lattice.map((p) => (
        <circle
          cx={p.x}
          cy={p.y}
          r="2.3"
          class="g-ig fill-coral"
          style={`--d:${p.d}s`}
        />
      ))}
    </svg>
  )
}

{
  variant === 'diffraction' && (
    <svg viewBox="0 0 36 36" class="glyph" aria-hidden="true">
      <circle
        cx="18"
        cy="18"
        r="5"
        fill="none"
        class="g-pulse stroke-coral"
        stroke-width="1.2"
      />
      {ring2.map((p) => (
        <circle cx={p.x} cy={p.y} r="1.3" class="fill-coral" opacity="0.3" />
      ))}
      {ring1.map((p) => (
        <circle cx={p.x} cy={p.y} r="1.8" class="fill-coral" opacity="0.55" />
      ))}
      <circle cx="18" cy="18" r="2.6" class="fill-coral" />
    </svg>
  )
}

<style>
  .glyph {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
  }
  @media (min-width: 768px) {
    .glyph {
      width: 2rem;
      height: 2rem;
    }
  }

  /* Education — 내려오는 전자빔(밝은 점)이 위→아래로 훑음 */
  .g-beam {
    transform-box: fill-box;
    transform-origin: center;
    animation: g-beam 2.8s ease-in-out infinite;
  }
  @keyframes g-beam {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    100% {
      transform: translateY(18px);
      opacity: 1;
    }
    45%,
    55% {
      opacity: 1;
    }
  }
  .g-node {
    transform-box: fill-box;
    transform-origin: center;
    animation: g-node 2.8s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes g-node {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.25);
    }
  }

  /* Experience — 점이 기관 사이 아치를 오감(떠났다 돌아옴) */
  .g-traj {
    transform-box: fill-box;
    animation: g-traj 3.2s ease-in-out infinite alternate;
  }
  @keyframes g-traj {
    0% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(4.5px, -12px);
    }
    50% {
      transform: translate(12px, -16px);
    }
    75% {
      transform: translate(19.5px, -12px);
    }
    100% {
      transform: translate(24px, 0);
    }
  }

  /* Honors — 3×3 격자가 대각선으로 순차 점등(누적되는 인정) */
  .g-ig {
    transform-box: fill-box;
    transform-origin: center;
    animation: g-ig 2.6s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes g-ig {
    0%,
    70%,
    100% {
      opacity: 0.28;
      transform: scale(1);
    }
    14% {
      opacity: 1;
      transform: scale(1.3);
    }
  }

  /* Contact — 회절 중심에서 퍼지는 맥동 링 */
  .g-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: g-pulse 2.8s ease-out infinite;
  }
  @keyframes g-pulse {
    0% {
      transform: scale(0.4);
      opacity: 0.55;
    }
    100% {
      transform: scale(2.3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .g-beam,
    .g-node,
    .g-traj,
    .g-ig,
    .g-pulse {
      animation: none;
    }
    .g-traj {
      transform: translate(12px, -16px); /* 아치 정점에 정지 */
    }
    .g-beam {
      transform: translateY(9px); /* 중앙 노드에 정지 */
    }
    .g-ig {
      opacity: 0.6;
    }
    .g-pulse {
      transform: scale(1.3);
      opacity: 0.2;
    }
  }
</style>
