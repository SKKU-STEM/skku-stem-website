---
// PI CV Publications 그룹 제목 옆 동적 그래픽 — 연구 두 갈래를 원자 도트 필드로 심상화.
// variant="lattice": HAADF-STEM 원자 격자(정렬·열진동·초점). variant="denoise": 딥러닝 노이즈 제거 전이(노이즈→복원 루프).
// 순수 Canvas + requestAnimationFrame. IntersectionObserver로 가시 영역에서만 구동, prefers-reduced-motion 시 정적 1프레임.
interface Props {
  variant: 'lattice' | 'denoise';
}
const { variant } = Astro.props;
---

<canvas
  data-pub-graphic
  data-variant={variant}
  class="pub-graphic"
  aria-hidden="true"></canvas>

<style>
  .pub-graphic {
    width: 5rem; /* 80px */
    height: 5rem;
    flex: none;
  }
  @media (min-width: 768px) {
    .pub-graphic {
      width: 6.5rem; /* 104px */
      height: 6.5rem;
    }
  }
</style>

<script>
  // 도트 격자 한 장: lattice/denoise 두 변주가 같은 6×6 사이트를 공유한다.
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const S = 120; // 논리 드로잉 좌표계(정사각)
  const N = 6; // 6×6 = 36 도트
  const PAD = 18;
  const STEP = (S - 2 * PAD) / (N - 1);

  function hexToRgb(hex: string): [number, number, number] {
    const m = hex.replace('#', '');
    return [
      parseInt(m.slice(0, 2), 16),
      parseInt(m.slice(2, 4), 16),
      parseInt(m.slice(4, 6), 16),
    ];
  }

  const rootStyle = getComputedStyle(document.documentElement);
  const CORAL = hexToRgb(rootStyle.getPropertyValue('--color-coral').trim() || '#CC785C');
  const INK = hexToRgb(rootStyle.getPropertyValue('--color-ink').trim() || '#141413');

  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const easeInOut = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  interface Dot {
    lx: number; // 격자 사이트(정렬 위치)
    ly: number;
    nx: number; // 노이즈 위치(랜덤 산포)
    ny: number;
    ph: number; // 열진동 위상
  }

  function buildDots(): Dot[] {
    const dots: Dot[] = [];
    for (let i = 0; i < N; i++) {
      for (let j = 0; j < N; j++) {
        dots.push({
          lx: PAD + i * STEP,
          ly: PAD + j * STEP,
          nx: PAD + Math.random() * (S - 2 * PAD),
          ny: PAD + Math.random() * (S - 2 * PAD),
          ph: Math.random() * Math.PI * 2,
        });
      }
    }
    return dots;
  }

  function initCanvas(canvas: HTMLCanvasElement) {
    const variant = canvas.dataset.variant;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = S * dpr;
    canvas.height = S * dpr;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.scale(dpr, dpr);

    const dots = buildDots();
    const group = canvas.closest<HTMLElement>('[data-pub-group]');
    let focus = 0; // 현재 호버 강도
    let targetFocus = 0; // 목표(0/1)
    if (group) {
      group.addEventListener('pointerenter', () => (targetFocus = 1));
      group.addEventListener('pointerleave', () => (targetFocus = 0));
    }

    // denoise 주기: 노이즈→복원→유지→재노이즈
    function clarityAt(ms: number): number {
      const period = 4600;
      const t = (ms % period) / period;
      if (t < 0.34) return easeInOut(t / 0.34);
      if (t < 0.66) return 1;
      return 1 - easeInOut((t - 0.66) / 0.34);
    }

    function frame(ms: number) {
      focus += (targetFocus - focus) * 0.08;
      ctx!.clearRect(0, 0, S, S);

      // 초점 링 — 중심에서 퍼지는 조리개. 호버 시 진해짐.
      const ringPeriod = 3000;
      const rp = (ms % ringPeriod) / ringPeriod;
      const ringR = lerp(8, S * 0.46, rp);
      const ringA = (1 - rp) * (0.1 + focus * 0.22);
      ctx!.beginPath();
      ctx!.arc(S / 2, S / 2, ringR, 0, Math.PI * 2);
      ctx!.strokeStyle = `rgba(${CORAL[0]},${CORAL[1]},${CORAL[2]},${ringA})`;
      ctx!.lineWidth = 1;
      ctx!.stroke();

      for (const d of dots) {
        let x: number, y: number, r: number, a: number;
        let col: number[];
        if (variant === 'denoise') {
          const c = Math.max(clarityAt(ms), focus); // 호버 시 즉시 복원
          const e = easeInOut(c);
          x = lerp(d.nx, d.lx, e);
          y = lerp(d.ny, d.ly, e);
          r = 0.7 + c * 1.1;
          a = 0.2 + c * 0.7;
          col = [
            lerp(INK[0], CORAL[0], c),
            lerp(INK[1], CORAL[1], c),
            lerp(INK[2], CORAL[2], c),
          ];
        } else {
          const amp = 1.3 - focus * 0.9; // 호버 시 진동 감쇠 → 선명
          x = d.lx + Math.sin(ms * 0.0015 + d.ph) * amp;
          y = d.ly + Math.cos(ms * 0.0013 + d.ph) * amp;
          r = 1.6 + focus * 0.7;
          a = 0.55 + focus * 0.35;
          col = CORAL;
        }
        ctx!.beginPath();
        ctx!.arc(x, y, r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(${col[0] | 0},${col[1] | 0},${col[2] | 0},${a})`;
        ctx!.fill();
      }
    }

    if (REDUCED) {
      frame(2300); // 복원된 격자 1프레임(루프 없음)
      return;
    }

    let raf = 0;
    const loop = (ms: number) => {
      frame(ms);
      raf = requestAnimationFrame(loop);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting && !raf) raf = requestAnimationFrame(loop);
          else if (!en.isIntersecting && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        }
      },
      { threshold: 0.05 }
    );
    io.observe(canvas);
  }

  document
    .querySelectorAll<HTMLCanvasElement>('canvas[data-pub-graphic]')
    .forEach(initCanvas);
</script>
