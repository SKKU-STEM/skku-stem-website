---
// 홈 히어로 가로 슬라이드 캐러셀 — hero.json의 slide 목록을 받아 src/assets/hero/<basename>를
// import.meta.glob으로 찾아 Astro <Image>(webp/반응형)로 변환하고 좌우 슬라이드로 자동 재생한다.
// hover/focus 또는 탭 비활성 시 일시정지, prefers-reduced-motion 시 자동재생/전환 애니메이션 없음.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Slide {
  image?: string;
  alt?: string;
  caption?: string;
}

interface Props {
  slides: Slide[];
  class?: string;
}

const { slides, class: className } = Astro.props;

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/hero/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const resolve = (srcPath?: string): ImageMetadata | null => {
  if (!srcPath) return null;
  const base = srcPath.split('/').pop();
  if (!base) return null;
  return heroImages[`/src/assets/hero/${base}`]?.default ?? null;
};

// 이미지가 실제로 존재하는 슬라이드만, 입력(=admin 드래그) 순서를 보존해 사용.
const resolved = slides
  .map((s) => ({ img: resolve(s.image), alt: s.alt ?? '', caption: s.caption }))
  .filter(
    (s): s is { img: ImageMetadata; alt: string; caption: string | undefined } =>
      s.img !== null,
  );

const multiple = resolved.length > 1;
const firstCaption = resolved[0]?.caption;
---

{
  resolved.length === 0 ? (
    <figure class:list={['hero-carousel', className]}>
      <div
        class="hero-carousel__viewport flex items-center justify-center border border-dashed border-ink/15"
        role="img"
        aria-label="Hero photo placeholder"
      >
        <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-ink/65 select-none">
          Photo
        </span>
      </div>
    </figure>
  ) : (
    <figure
      class:list={['hero-carousel', className]}
      data-hero-carousel
      aria-roledescription="carousel"
      aria-label="Lab photos"
    >
      <div class="hero-carousel__viewport">
        <ul class="hero-carousel__track" data-hero-track>
          {resolved.map((s, i) => (
            <li
              class="hero-carousel__slide"
              data-caption={s.caption ?? ''}
              aria-hidden={multiple && i !== 0 ? 'true' : undefined}
            >
              <Image
                src={s.img}
                alt={s.alt}
                widths={[800, 1200, 1600]}
                sizes="(max-width: 768px) 100vw, 50vw"
                format="webp"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                class="hero-carousel__img"
              />
            </li>
          ))}
        </ul>

        {multiple && (
          <>
            <button
              type="button"
              class="hero-carousel__arrow hero-carousel__arrow--prev"
              data-hero-prev
              aria-label="Previous slide"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 18l-6-6 6-6" />
              </svg>
            </button>
            <button
              type="button"
              class="hero-carousel__arrow hero-carousel__arrow--next"
              data-hero-next
              aria-label="Next slide"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M9 18l6-6-6-6" />
              </svg>
            </button>
          </>
        )}
      </div>

      <div class="hero-carousel__bar">
        <figcaption class="hero-carousel__caption" data-hero-caption>
          {firstCaption ? `— ${firstCaption}` : ''}
        </figcaption>

        {multiple && (
          <div class="hero-carousel__dots" data-hero-dots>
            {resolved.map((_, i) => (
              <button
                type="button"
                class="hero-carousel__dot"
                data-hero-dot={i}
                aria-label={`Go to slide ${i + 1}`}
                aria-current={i === 0 ? 'true' : undefined}
              />
            ))}
          </div>
        )}
      </div>
    </figure>
  )
}

<style>
  .hero-carousel {
    margin: 0;
  }

  .hero-carousel__viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    width: 100%;
    background-color: color-mix(in oklab, var(--color-cream-200) 60%, transparent);
  }

  .hero-carousel__track {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-carousel__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
  }

  .hero-carousel__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: darken;
  }

  /* 좌우 화살표 — 평소엔 숨고 hover/focus 시 노출, 터치 기기에선 항상 옅게 노출. */
  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    background-color: color-mix(in oklab, var(--color-cream) 82%, transparent);
    color: var(--color-ink);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .hero-carousel:hover .hero-carousel__arrow,
  .hero-carousel:focus-within .hero-carousel__arrow {
    opacity: 1;
  }

  .hero-carousel__arrow:hover {
    background-color: var(--color-cream);
  }

  .hero-carousel__arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .hero-carousel__arrow--prev {
    left: 0.75rem;
  }

  .hero-carousel__arrow--next {
    right: 0.75rem;
  }

  @media (hover: none) {
    .hero-carousel__arrow {
      opacity: 0.6;
    }
  }

  /* caption(좌) + dots(우)를 한 줄에 배치. */
  .hero-carousel__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .hero-carousel__caption {
    font-size: 0.75rem;
    font-style: italic;
    color: color-mix(in oklab, var(--color-ink) 60%, transparent);
  }

  .hero-carousel__dots {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .hero-carousel__dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--color-ink) 20%, transparent);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .hero-carousel__dot[aria-current='true'] {
    background-color: var(--color-coral);
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel__track {
      transition: none;
    }
  }
</style>

<script>
  // 가로 슬라이드 + 자동재생 컨트롤러. 슬라이드가 2장 이상일 때만 동작.
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-hero-track]');
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>('.hero-carousel__slide'),
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'),
    );
    const caption = root.querySelector<HTMLElement>('[data-hero-caption]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-hero-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-hero-next]');

    if (!track || slides.length <= 1) return;

    const count = slides.length;
    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;
    const INTERVAL = 5000;
    let index = 0;
    let timer: number | undefined;

    function go(to: number) {
      index = (to + count) % count;
      track!.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((d, i) =>
        i === index
          ? d.setAttribute('aria-current', 'true')
          : d.removeAttribute('aria-current'),
      );
      slides.forEach((s, i) =>
        i === index
          ? s.removeAttribute('aria-hidden')
          : s.setAttribute('aria-hidden', 'true'),
      );
      if (caption) {
        const cap = slides[index].getAttribute('data-caption') ?? '';
        caption.textContent = cap ? `— ${cap}` : '';
      }
    }

    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    function start() {
      if (reduceMotion) return;
      stop();
      timer = window.setInterval(() => go(index + 1), INTERVAL);
    }

    prevBtn?.addEventListener('click', () => {
      go(index - 1);
      start();
    });
    nextBtn?.addEventListener('click', () => {
      go(index + 1);
      start();
    });
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        go(i);
        start();
      }),
    );

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start(),
    );

    go(0);
    start();
  }

  document
    .querySelectorAll<HTMLElement>('[data-hero-carousel]')
    .forEach(initCarousel);
</script>
